{
  "name": "ritm-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "dev": "node build-assets.mjs && wrangler dev",
    "build": "node build-assets.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "node build-assets.mjs && wrangler deploy",
    "test": "node --test *.test.mjs",
    "db:local": "wrangler d1 execute DB --local --file schema.sql",
    "db:remote": "wrangler d1 execute DB --remote --file schema.sql"
  },
  "devDependencies": {"wrangler": "4.92.0", "eslint": "9.39.4", "pdfjs-dist": "6.3.289"}
}
